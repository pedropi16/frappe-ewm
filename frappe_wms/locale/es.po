#: frappe_wms/wms_setup/doctype/wms_hu_number_pool/wms_hu_number_pool.json
msgid ""
"A number freed by recycling a reusable, empty Handling Unit - handed out "
"again by services/numbering.next_number before the range increments "
"further."
msgstr ""
"Un número liberado al reciclar una unidad de manipulación reutilizable y "
