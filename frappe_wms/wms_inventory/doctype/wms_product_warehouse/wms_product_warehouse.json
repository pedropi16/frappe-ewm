{
  "name": "WMS Product Warehouse",
  "module": "WMS Inventory",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "item",
    "warehouse",
    "fixed_bin",
    "preferred_storage_type",
    "putaway_control_indicator",
    "stock_removal_control_indicator",
    "storage_section_indicator",
    "two_step_picking",
    "storage_type_limits",
    "process_type_determination_indicator",
    "active"
  ],
  "fields": [
    {
      "fieldname": "item",
      "label": "Item",
      "fieldtype": "Link",
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "fixed_bin",
      "label": "Fixed Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "description": "This product's home bin in this warehouse - used by the Near Fixed Bin putaway strategy."
    },
    {
      "fieldname": "preferred_storage_type",
      "label": "Preferred Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type",
      "description": "Overrides WMS Product's global Preferred Storage Type for this warehouse only. Leave blank to use the global value."
    },
    {
      "fieldname": "process_type_determination_indicator",
      "label": "Process Type Determination Indicator",
      "fieldtype": "Data",
      "description": "Optional free-text key a Warehouse Process Type Determination Rule can match on for this product in this warehouse."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "putaway_control_indicator",
      "label": "Putaway Control Indicator",
      "fieldtype": "Link",
      "options": "Putaway Control Indicator"
    },
    {
      "fieldname": "stock_removal_control_indicator",
      "label": "Stock Removal Control Indicator",
      "fieldtype": "Link",
      "options": "Stock Removal Control Indicator"
    },
    {
      "fieldname": "storage_section_indicator",
      "label": "Storage Section Indicator",
      "fieldtype": "Link",
      "options": "Storage Section Indicator"
    },
    {
      "fieldname": "two_step_picking",
      "label": "Two-Step Picking",
      "fieldtype": "Check",
      "description": "Picks of this product always go through the shared picking staging bin, whatever the process type says."
    },
    {
      "fieldname": "storage_type_limits",
      "label": "Storage Type Limits",
      "fieldtype": "Table",
      "options": "WMS Product Storage Type"
    }
  ],
  "autoname": "format:{warehouse}-{item}",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
