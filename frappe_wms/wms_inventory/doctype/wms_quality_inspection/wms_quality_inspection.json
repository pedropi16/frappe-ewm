      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "WMS Inventory Controller",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "WMS Operator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0
    }
  ]
}
