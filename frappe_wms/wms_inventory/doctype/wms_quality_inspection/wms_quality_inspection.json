    {
      "fieldname": "passed_to_stock_type",
      "label": "Passed To Stock Type",
      "fieldtype": "Link",
      "options": "WMS Stock Type",
      "default": "AVAILABLE"
    },
    {
      "fieldname": "failed_quantity",
      "label": "Failed Quantity",
      "fieldtype": "Float",
      "default": 0
