{
  "name": "WMS Quality Inspection",
  "module": "WMS Inventory",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "warehouse",
    "product",
    "batch_no",
    "serial_no",
    "handling_unit",
    "storage_bin",
    "from_stock_type",
    "quantity",
    "sampling_percentage",
    "acceptable_failures",
    "stock_uom",
    "status",
    "passed_quantity",
    "passed_to_stock_type",
    "failed_quantity",
    "failed_to_stock_type",
    "samples",
    "sample_result",
    "decisions",
    "remarks",
    "inspector",
    "inspection_date",
    "completed_at",
    "goods_receipt",
    "erpnext_quality_inspection",
    "erpnext_stock_entry"
  ],
  "fields": [
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "product",
      "label": "Product",
      "fieldtype": "Link",
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "batch_no",
      "label": "Batch",
      "fieldtype": "Link",
      "options": "Batch"
    },
    {
      "fieldname": "serial_no",
      "label": "Serial Number",
      "fieldtype": "Link",
      "options": "Serial No"
    },
    {
      "fieldname": "handling_unit",
      "label": "Handling Unit",
      "fieldtype": "Link",
      "options": "Handling Unit",
      "in_list_view": 1
    },
    {
      "fieldname": "storage_bin",
      "label": "Storage Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "reqd": 1
    },
    {
      "fieldname": "from_stock_type",
      "label": "From Stock Type",
      "fieldtype": "Link",
      "options": "WMS Stock Type",
      "reqd": 1,
      "default": "QUALITY"
    },
    {
      "fieldname": "quantity",
      "label": "Quantity",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "stock_uom",
      "label": "Stock UOM",
      "fieldtype": "Link",
      "options": "UOM",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nCompleted\nCancelled",
      "reqd": 1,
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "passed_quantity",
      "label": "Passed Quantity",
      "fieldtype": "Float",
      "default": 0
    },
    {
      "fieldname": "passed_to_stock_type",
      "label": "Passed To Stock Type",
      "fieldtype": "Link",
      "options": "WMS Stock Type",
      "default": "AVAILABLE"
    },
    {
      "fieldname": "failed_quantity",
      "label": "Failed Quantity",
      "fieldtype": "Float",
      "default": 0
    },
    {
      "fieldname": "failed_to_stock_type",
      "label": "Failed To Stock Type",
      "fieldtype": "Link",
      "options": "WMS Stock Type",
      "default": "DAMAGED"
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "inspector",
      "label": "Inspector",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "inspection_date",
      "label": "Inspection Date",
      "fieldtype": "Date",
      "default": "Today"
    },
    {
      "fieldname": "completed_at",
      "label": "Completed At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "goods_receipt",
      "label": "Goods Receipt",
      "fieldtype": "Link",
      "options": "Goods Receipt",
      "read_only": 1,
      "description": "Set when this inspection was auto-created from an Inspection Rule matching a Goods Receipt row."
    },
    {
      "fieldname": "erpnext_quality_inspection",
      "label": "ERPNext Quality Inspection",
      "fieldtype": "Link",
      "options": "Quality Inspection",
      "read_only": 1
    },
    {
      "fieldname": "erpnext_stock_entry",
      "label": "ERPNext Stock Entry",
      "fieldtype": "Link",
      "options": "Stock Entry",
      "read_only": 1,
      "description": "Same-warehouse Material Transfer posted to change the WMS Stock Type Inventory Dimension in ERPNext to match this decision, if the warehouse is ERPNext-linked."
    },
    {
      "fieldname": "sampling_percentage",
      "label": "Sampling %",
      "fieldtype": "Percent",
      "description": "From the Inspection Rule at creation; below 100 the inspection works on samples."
    },
    {
      "fieldname": "acceptable_failures",
      "label": "Acceptable Failed Samples",
      "fieldtype": "Int",
      "description": "More failed samples than this rejects the whole inspection."
    },
    {
      "fieldname": "samples",
      "label": "Samples",
      "fieldtype": "Table",
      "options": "WMS QI Sample"
    },
    {
      "fieldname": "sample_result",
      "label": "Sample Result",
      "fieldtype": "Select",
      "options": "Pending\nAccept\nReject",
      "read_only": 1,
      "default": "Pending"
    },
    {
      "fieldname": "decisions",
      "label": "Usage Decisions",
      "fieldtype": "Table",
      "options": "WMS QI Decision",
      "description": "Split the inspected quantity over usage decisions (accept, rework, scrap ...). Without decisions the passed/failed quantities are used."
    }
  ],
  "autoname": "QI-.########",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "WMS Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Inventory Controller",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Operator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Receiver",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Picker",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Packer",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Loader",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Supervisor",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Process Engineer",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Master Data",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Integration User",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Auditor",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ]
}