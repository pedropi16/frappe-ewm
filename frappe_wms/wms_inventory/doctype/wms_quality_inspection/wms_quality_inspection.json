    {
      "fieldname": "goods_receipt",
      "label": "Goods Receipt",
      "fieldtype": "Link",
      "options": "Goods Receipt",
      "read_only": 1,
      "description": "Set when this inspection was auto-created from an Inspection Rule matching a Goods Receipt row."
    },
    {
      "fieldname": "erpnext_quality_inspection",
      "label": "ERPNext Quality Inspection",
      "fieldtype": "Link",
      "options": "Quality Inspection",
      "read_only": 1
