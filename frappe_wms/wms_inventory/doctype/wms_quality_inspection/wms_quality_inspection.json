    {
      "fieldname": "failed_to_stock_type",
      "label": "Failed To Stock Type",
      "fieldtype": "Link",
      "options": "WMS Stock Type",
      "default": "DAMAGED"
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "inspector",
      "label": "Inspector",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "inspection_date",
      "label": "Inspection Date",
      "fieldtype": "Date",
      "default": "Today"
    },
    {
      "fieldname": "completed_at",
      "label": "Completed At",
      "fieldtype": "Datetime",
      "read_only": 1
