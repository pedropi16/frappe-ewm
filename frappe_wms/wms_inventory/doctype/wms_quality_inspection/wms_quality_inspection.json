      "in_list_view": 1
    },
    {
      "fieldname": "batch_no",
      "label": "Batch",
      "fieldtype": "Link",
      "options": "Batch"
    },
    {
      "fieldname": "serial_no",
      "label": "Serial Number",
      "fieldtype": "Link",
      "options": "Serial No"
    },
    {
      "fieldname": "handling_unit",
      "label": "Handling Unit",
      "fieldtype": "Link",
      "options": "Handling Unit",
      "in_list_view": 1
    },
    {
      "fieldname": "storage_bin",
      "label": "Storage Bin",
      "fieldtype": "Link",
