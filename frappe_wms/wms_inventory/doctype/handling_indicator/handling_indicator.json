  "fields": [
    {
      "fieldname": "indicator_code",
      "label": "Indicator Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "indicator_name",
      "label": "Indicator Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "required_storage_group",
      "label": "Required Storage Group",
      "fieldtype": "Link",
      "options": "Storage Group",
      "in_list_view": 1,
      "description": "Products with this indicator are only put into bins of this storage group (e.g. a cold room for temperature-sensitive goods)."
    },
    {
      "fieldname": "no_unpack",
      "label": "Do Not Unpack",
      "fieldtype": "Check",
      "in_list_view": 1,
      "description": "The product stays in its Handling Unit: no loose or partial moves out of it, no repacking, no deconsolidation."
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    }
  ],
  "sort_field": "modified",
