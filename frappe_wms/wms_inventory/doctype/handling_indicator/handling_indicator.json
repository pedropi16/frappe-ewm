{
  "name": "Handling Indicator",
  "module": "WMS Inventory",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "indicator_code",
    "indicator_name",
    "required_storage_group",
    "no_unpack",
    "description",
    "active"
