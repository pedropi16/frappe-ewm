    },
    {
      "fieldname": "hazard_class",
      "label": "Hazard Class",
      "fieldtype": "Link",
      "options": "Hazard Class",
      "description": "Dangerous goods: where it may be stored follows from this class."
    },
    {
      "fieldname": "un_number",
      "label": "UN Number",
      "fieldtype": "Data"
    },
    {
      "fieldname": "packing_group",
