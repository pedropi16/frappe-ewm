    },
    {
      "role": "WMS Loader",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Process Engineer",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Master Data",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Integration User",
      "read": 1,
      "report": 1,
