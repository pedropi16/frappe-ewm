{
  "name": "WMS Physical Inventory Count",
  "module": "WMS Inventory",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "warehouse",
    "storage_bin",
    "storage_type",
    "product",
    "count_date",
    "status",
    "assigned_resource",
    "items",
    "counted_by",
    "counted_at",
    "posted_by",
    "posted_at",
    "erpnext_gain_stock_entry",
    "erpnext_loss_stock_entry",
    "approved_by",
    "approved_at",
    "review_remarks",
    "blocked_bins"
  ],
  "fields": [
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "storage_bin",
      "label": "Storage Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "description": "Limit the count to a single bin. Leave blank with a Storage Type (or both blank for the whole warehouse)."
    },
    {
      "fieldname": "storage_type",
      "label": "Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type"
    },
    {
      "fieldname": "product",
      "label": "Product",
      "fieldtype": "Link",
      "options": "Item",
      "description": "Optionally limit the count to a single product (cycle count)."
    },
    {
      "fieldname": "count_date",
      "label": "Count Date",
      "fieldtype": "Date",
      "reqd": 1,
      "default": "Today",
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nCounting\nCounted\nUnder Review\nPosted\nCancelled",
      "reqd": 1,
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "assigned_resource",
      "label": "Assigned Resource",
      "fieldtype": "Link",
      "options": "WMS Resource",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Claimed by a resource pulling from a counting queue (System Guided). Blank until claimed or when started by a direct scan (Manual)."
    },
    {
      "fieldname": "items",
      "label": "Items",
      "fieldtype": "Table",
      "options": "WMS Physical Inventory Count Item"
    },
    {
      "fieldname": "counted_by",
      "label": "Counted By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "counted_at",
      "label": "Counted At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "posted_by",
      "label": "Posted By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "posted_at",
      "label": "Posted At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "erpnext_gain_stock_entry",
      "label": "ERPNext Gain Stock Entry",
      "fieldtype": "Data",
      "read_only": 1,
      "description": "ERPNext Stock Entry - several, comma-separated, when the count posted in more than one pass (recount/approval)"
    },
    {
      "fieldname": "erpnext_loss_stock_entry",
      "label": "ERPNext Loss Stock Entry",
      "fieldtype": "Data",
      "read_only": 1,
      "description": "ERPNext Stock Entry - several, comma-separated, when the count posted in more than one pass (recount/approval)"
    },
    {
      "fieldname": "approved_by",
      "label": "Approved By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "approved_at",
      "label": "Approved At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "review_remarks",
      "label": "Review Remarks",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "blocked_bins",
      "label": "Blocked Bins",
      "fieldtype": "Small Text",
      "read_only": 1,
      "description": "Storage Bins this count set removal_blocked on at snapshot time (that were not already blocked) - unblocked automatically once the count posts or is cancelled."
    }
  ],
  "autoname": "PIC-.########",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
