{
  "name": "WMS Physical Inventory Count",
  "module": "WMS Inventory",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "warehouse",
    "storage_bin",
    "storage_type",
    "product",
    "count_date",
    "status",
    "items",
    "counted_by",
    "counted_at",
    "posted_by",
    "posted_at"
  ],
  "fields": [
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "storage_bin",
      "label": "Storage Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "description": "Limit the count to a single bin. Leave blank with a Storage Type (or both blank for the whole warehouse)."
    },
    {
      "fieldname": "storage_type",
      "label": "Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type"
    },
    {
      "fieldname": "product",
      "label": "Product",
      "fieldtype": "Link",
      "options": "Item",
      "description": "Optionally limit the count to a single product (cycle count)."
    },
    {
      "fieldname": "count_date",
      "label": "Count Date",
      "fieldtype": "Date",
      "reqd": 1,
      "default": "Today",
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nCounting\nCounted\nPosted\nCancelled",
      "reqd": 1,
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "items",
      "label": "Items",
      "fieldtype": "Table",
      "options": "WMS Physical Inventory Count Item"
    },
    {
      "fieldname": "counted_by",
      "label": "Counted By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "counted_at",
      "label": "Counted At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "posted_by",
      "label": "Posted By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "posted_at",
      "label": "Posted At",
      "fieldtype": "Datetime",
      "read_only": 1
    }
  ],
  "autoname": "PIC-.########",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "WMS Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "WMS Inventory Controller",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "WMS Operator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0
    }
  ]
}
