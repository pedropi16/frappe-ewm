{
  "name": "WMS Resource",
  "module": "WMS Execution",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "resource_code",
    "warehouse",
    "resource_group",
    "resource_type",
    "device_id",
    "user",
    "logged_in_at",
    "current_queue",
    "current_work_center",
    "current_bin",
    "active",
    "printer_section",
    "printer_connection",
    "printer_language",
    "column_break_printer",
    "printer_host",
    "printer_port",
    "agent_printer_name"
  ],
  "fields": [
    {
      "fieldname": "resource_code",
      "label": "Resource Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "resource_group",
      "label": "Resource Group",
      "fieldtype": "Link",
      "options": "WMS Resource Group",
      "description": "The pool this physical device belongs to - a Warehouse Queue routes work to a Resource Group, not to one device directly."
    },
    {
      "fieldname": "resource_type",
      "label": "Resource Type",
      "fieldtype": "Select",
      "options": "Operator\nForklift\nReach Truck\nPicking Trolley\nPacking Station\nScanner\nPrinter",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "device_id",
      "label": "Device ID",
      "fieldtype": "Data",
      "description": "Physical identifier of the device itself (serial number, MAC address, printer queue name, ...)."
    },
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "description": "Whoever is currently logged on to this device - normally set via Log On in the RF app (services/resource.log_on), not edited here directly, though a Supervisor can still fix it by hand if needed. A Resource models the device, not the person; only one user is logged on at a time, and a Supervisor can Kick whoever's on it."
    },
    {
      "fieldname": "logged_in_at",
      "label": "Logged In At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "current_queue",
      "label": "Current Queue",
      "fieldtype": "Link",
      "options": "Warehouse Queue"
    },
    {
      "fieldname": "current_work_center",
      "label": "Current Work Center",
      "fieldtype": "Link",
      "options": "Work Center",
      "description": "Optional - an operator logs on to a Work Center only when the actions they're about to do need one (VAS generation, Packing, Kitting), so its bin can be defaulted instead of scanned every time."
    },
    {
      "fieldname": "current_bin",
      "label": "Current Bin",
      "fieldtype": "Link",
      "options": "Storage Bin"
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "printer_section",
      "label": "Printer",
      "fieldtype": "Section Break",
      "depends_on": "eval:doc.resource_type==\"Printer\"",
      "description": "How print jobs reach this printer. Network: the server sends ZPL straight to the printer (raw TCP, usually port 9100). Print Agent: the on-site agent (frappe_wms/print_agent/wms_print_agent.py) collects jobs and prints them locally - use it when the server cannot reach the printer, or for PDF."
    },
    {
      "fieldname": "printer_connection",
      "label": "Connection",
      "fieldtype": "Select",
      "options": "Print Agent\nNetwork (Raw TCP)",
      "default": "Print Agent"
    },
    {
      "fieldname": "printer_language",
      "label": "Printer Language",
      "fieldtype": "Select",
      "options": "ZPL\nPDF",
      "default": "ZPL",
      "description": "ZPL for label printers (Zebra and compatibles), PDF for office printers (agent only)."
    },
    {
      "fieldname": "column_break_printer",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "printer_host",
      "label": "Printer Address",
      "fieldtype": "Data",
      "depends_on": "eval:doc.printer_connection==\"Network (Raw TCP)\""
    },
    {
      "fieldname": "printer_port",
      "label": "Printer Port",
      "fieldtype": "Int",
      "default": "9100",
      "depends_on": "eval:doc.printer_connection==\"Network (Raw TCP)\""
    },
    {
      "fieldname": "agent_printer_name",
      "label": "Agent Printer Name",
      "fieldtype": "Data",
      "depends_on": "eval:doc.printer_connection==\"Print Agent\"",
      "description": "The printer name as the agent's computer knows it (e.g. the CUPS queue). Blank = the agent's default printer."
    }
  ],
  "autoname": "field:resource_code",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Operator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Receiver",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Picker",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Packer",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Loader",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Inventory Controller",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Supervisor",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Process Engineer",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Master Data",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Integration User",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Auditor",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ]
}
