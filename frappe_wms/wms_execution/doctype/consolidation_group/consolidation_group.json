{
  "name": "Consolidation Group",
  "module": "WMS Execution",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "warehouse",
    "staging_bin",
    "production_supply_area",
    "material_request",
    "deconsolidation_bin",
    "target_hu",
    "priority",
    "status",
    "gather_status",
    "lines",
    "completed_at",
    "completed_by"
  ],
  "fields": [
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "staging_bin",
      "label": "Staging Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "reqd": 1,
      "in_list_view": 1,
      "description": "The physical consolidation point - e.g. a Production Supply Area bin or a rack. Where the target Handling Unit is gathered before being split out to its final destinations."
    },
    {
      "fieldname": "target_hu",
      "label": "Target Handling Unit",
      "fieldtype": "Link",
      "options": "Handling Unit",
      "in_list_view": 1,
      "description": "Blank until the first line is gathered onto it."
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nNormal\nHigh\nUrgent",
      "default": "Normal",
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nOpen\nCompleted\nCancelled",
      "reqd": 1,
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "gather_status",
      "label": "Gather Status",
      "fieldtype": "Select",
      "options": "Not Started\nPartially Gathered\nFully Gathered",
      "reqd": 1,
      "default": "Not Started",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "lines",
      "label": "Lines",
      "fieldtype": "Table",
      "options": "Consolidation Group Line"
    },
    {
      "fieldname": "completed_at",
      "label": "Completed At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "completed_by",
      "label": "Completed By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "production_supply_area",
      "label": "Production Supply Area",
      "fieldtype": "Link",
      "options": "Production Supply Area",
      "read_only": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "material_request",
      "label": "Material Request",
      "fieldtype": "Link",
      "options": "Material Request",
      "read_only": 1,
      "in_standard_filter": 1,
      "description": "Set when this group delivers one Material Request's material to a Production Supply Area."
    },
    {
      "fieldname": "deconsolidation_bin",
      "label": "Deconsolidation Location",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "read_only": 1,
      "description": "The location of the deconsolidation work center collecting this Material Request's material."
    }
  ],
  "autoname": "CONSOL-.########",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
