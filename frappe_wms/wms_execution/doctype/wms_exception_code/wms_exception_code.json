{
  "name": "WMS Exception Code",
  "module": "WMS Execution",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "exception_code",
    "exception_name",
    "category",
    "business_context",
    "system_action",
    "allowed_task_types",
    "requires_supervisor",
    "requires_comment",
    "allows_quantity_change",
    "allows_bin_change",
    "follow_up_action",
    "difference_category",
    "active"
  ],
  "fields": [
    {
      "fieldname": "exception_code",
      "label": "Exception Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "exception_name",
      "label": "Exception Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Select",
      "options": "Stock\nBin\nHandling Unit\nTask\nRoute\nQuality\nSystem",
      "reqd": 1
    },
    {
      "fieldname": "allowed_task_types",
      "label": "Allowed Task Types",
      "fieldtype": "Table",
      "options": "Allowed Task Type"
    },
    {
      "fieldname": "requires_supervisor",
      "label": "Requires Supervisor",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "requires_comment",
      "label": "Requires Comment",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "allows_quantity_change",
      "label": "Allows Quantity Change",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "allows_bin_change",
      "label": "Allows Bin Change",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "follow_up_action",
      "label": "Follow-up Action",
      "fieldtype": "Select",
      "options": "None\nBlock Stock\nBlock HU\nCreate Difference Task\nCancel Task\nCreate Follow-up Task",
      "reqd": 1,
      "default": "None"
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "business_context",
      "label": "Business Context",
      "fieldtype": "Select",
      "options": "Any\nTask Execution (RF)\nTask Execution (Desktop)\nPacking\nPhysical Inventory",
      "default": "Any",
      "description": "Where the code is offered."
    },
    {
      "fieldname": "system_action",
      "label": "System Action",
      "fieldtype": "Select",
      "options": "\nChange Bin\nSplit Task\nSkip Task\nPost Difference",
      "description": "What the system does when the code is raised. Change Bin: the task goes to another bin (destination for putaway-type tasks, else source). Split Task: part of the quantity becomes a new task, optionally to another bin. Skip Task: the task moves to the back of its order. Post Difference: the task closes at the quantity found and the shortfall is booked as a difference (same as 'Allows quantity change')."
    },
    {
      "fieldname": "difference_category",
      "fieldtype": "Select",
      "label": "Difference Category",
      "options": "\nMissing\nDamaged\nWrong Product\nExpired\nSurplus\nOther",
      "description": "What a short confirmation under this code is booked as in the Difference Analyzer (SAP: difference reason)"
    }
  ],
  "autoname": "field:exception_code",
  "title_field": "exception_name",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
