{
  "name": "Warehouse Queue",
  "module": "WMS Execution",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "queue_code",
    "queue_name",
    "warehouse",
    "activity",
    "storage_type",
    "required_resource_type",
    "sequence_rule",
    "active"
  ],
  "fields": [
    {
      "fieldname": "queue_code",
      "label": "Queue Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "queue_name",
      "label": "Queue Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "activity",
      "label": "Activity",
      "fieldtype": "Select",
      "options": "Unload\nPutaway\nPick\nInternal Move\nDeconsolidation\nPack\nStage\nLoad\nPosting Change\nInventory Count",
      "reqd": 1
    },
    {
      "fieldname": "storage_type",
      "label": "Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type"
    },
    {
      "fieldname": "required_resource_type",
      "label": "Required Resource Type",
      "fieldtype": "Select",
      "options": "Operator\nForklift\nReach Truck\nPicking Trolley\nPacking Station\nScanner"
    },
    {
      "fieldname": "sequence_rule",
      "label": "Sequence Rule",
      "fieldtype": "Select",
      "options": "Priority Then FIFO\nFIFO\nBin Sequence\nDelivery Sequence\nOldest Stock First",
      "reqd": 1,
      "default": "Priority Then FIFO"
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    }
  ],
  "autoname": "field:queue_code",
  "title_field": "queue_name",
  "sort_field": "modified",
  "sort_order": "DESC",
