{
  "name": "Kitting Order",
  "module": "WMS Execution",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "kit_item",
    "bom",
    "warehouse",
    "work_center_bin",
    "quantity",
    "direction",
    "status",
    "destination_hu",
    "putaway_output",
    "components",
    "erpnext_stock_entry",
    "completed_at",
    "completed_by"
  ],
  "fields": [
    {
      "fieldname": "kit_item",
      "label": "Kit Item",
      "fieldtype": "Link",
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "bom",
      "label": "BOM",
      "fieldtype": "Link",
      "options": "BOM",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "work_center_bin",
      "label": "Work Center Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "reqd": 1
    },
    {
      "fieldname": "quantity",
      "label": "Quantity",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "direction",
      "label": "Direction",
      "fieldtype": "Select",
      "options": "Assemble\nDisassemble",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nOpen\nCompleted\nCancelled",
      "reqd": 1,
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "destination_hu",
      "fieldtype": "Link",
      "label": "Output Handling Unit",
      "options": "Handling Unit",
      "read_only": 1
    },
    {
      "fieldname": "putaway_output",
      "fieldtype": "Check",
      "label": "Put Away Output",
      "default": "0",
      "description": "Defaults from the warehouse's Kitting settings."
    },
    {
      "fieldname": "components",
      "label": "Components",
      "fieldtype": "Table",
      "options": "Kitting Order Component"
    },
    {
      "fieldname": "erpnext_stock_entry",
      "label": "ERPNext Stock Entry",
      "fieldtype": "Link",
      "options": "Stock Entry",
      "read_only": 1
    },
    {
      "fieldname": "completed_at",
      "label": "Completed At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "completed_by",
      "label": "Completed By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    }
  ],
  "autoname": "KIT-.########",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
