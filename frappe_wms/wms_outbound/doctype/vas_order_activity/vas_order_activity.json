{
  "name": "VAS Order Activity",
  "module": "WMS Outbound",
  "custom": 0,
  "is_submittable": 0,
  "istable": 1,
  "track_changes": 0,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "step_no",
    "activity_type",
    "instruction",
    "quantity",
    "stock_uom",
    "completed",
    "completed_by",
    "completed_at",
    "remarks",
    "started_at",
    "duration_seconds",
    "packaging_spec_level"
  ],
  "fields": [
    {
      "fieldname": "step_no",
      "label": "Step",
      "fieldtype": "Int",
      "in_list_view": 1
    },
    {
      "fieldname": "activity_type",
      "label": "Activity Type",
      "fieldtype": "Select",
      "options": "Label\nKit\nAssemble\nWrap\nInsert\nInspect\nOther",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "instruction",
      "label": "Instruction",
      "fieldtype": "Small Text",
      "in_list_view": 1
    },
    {
      "fieldname": "quantity",
      "label": "Quantity",
      "fieldtype": "Float"
    },
    {
      "fieldname": "stock_uom",
      "label": "UOM",
      "fieldtype": "Link",
      "options": "UOM"
    },
    {
      "fieldname": "completed",
      "label": "Completed",
      "fieldtype": "Check",
      "default": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "completed_by",
      "label": "Completed By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "completed_at",
      "label": "Completed At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Data"
    },
    {
      "fieldname": "started_at",
      "label": "Started At",
      "fieldtype": "Datetime",
      "read_only": 1,
      "description": "Set when the parent VAS Order is created - an approximation, not the moment an operator actually began this step."
    },
    {
      "fieldname": "duration_seconds",
      "label": "Duration (Seconds)",
      "fieldtype": "Float",
      "read_only": 1
    },
    {
      "fieldname": "packaging_spec_level",
      "label": "Packaging Spec Level",
      "fieldtype": "Data",
      "description": "Optional - names the Packaging Spec Level this Kit/Wrap step targets."
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": []
}
