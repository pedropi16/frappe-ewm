{
  "name": "Outbound Delivery",
  "module": "WMS Outbound",
  "custom": 0,
  "is_submittable": 1,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "outbound_delivery_number",
    "warehouse",
    "document_type",
    "delivery_request",
    "customer",
    "stock_owner",
    "entitled_party",
    "ship_to_party",
    "delivery_date",
    "priority",
    "route",
    "staging_bin",
    "pick_pack_pass_hu",
    "door",
    "status",
    "allocation_status",
    "picking_status",
    "packing_status",
    "loading_status",
    "goods_issue_status",
    "external_reference",
    "customer_instruction_reference",
    "items",
    "remarks",
    "erp_section",
    "erp_source_doctype",
    "erp_source_name",
    "column_break_erp",
    "closed_short",
    "close_reason"
  ],
  "fields": [
    {
      "fieldname": "outbound_delivery_number",
      "label": "Outbound Delivery Number",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "ship_to_party",
      "label": "Ship-to Party",
      "fieldtype": "Data"
    },
    {
      "fieldname": "delivery_date",
      "label": "Delivery Date",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nNormal\nHigh\nUrgent",
      "reqd": 1,
      "default": "Normal"
    },
    {
      "fieldname": "route",
      "label": "Route",
      "fieldtype": "Link",
      "options": "WMS Route"
    },
    {
      "fieldname": "staging_bin",
      "label": "Staging Bin",
      "fieldtype": "Link",
      "options": "Storage Bin"
    },
    {
      "fieldname": "pick_pack_pass_hu",
      "label": "Pick-Pack-Pass HU",
      "fieldtype": "Link",
      "options": "Handling Unit",
      "read_only": 1,
      "description": "Auto-created once for this delivery under a Pick-Pack-Pass process type - every pick line for it lands directly in this one shared HU, skipping a separate packing step."
    },
    {
      "fieldname": "door",
      "label": "Door",
      "fieldtype": "Link",
      "options": "Storage Bin"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nOpen\nAllocated\nPicking\nPicked\nPacking\nPacked\nStaging\nStaged\nLoading\nLoaded\nGoods Issued\nCompleted\nCancelled",
      "reqd": 1,
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "allocation_status",
      "label": "Allocation Status",
      "fieldtype": "Select",
      "options": "Not Allocated\nPartially Allocated\nFully Allocated",
      "reqd": 1,
      "default": "Not Allocated",
      "read_only": 1
    },
    {
      "fieldname": "picking_status",
      "label": "Picking Status",
      "fieldtype": "Select",
      "options": "Not Started\nPartially Picked\nPicked\nNot Relevant",
      "reqd": 1,
      "default": "Not Started",
      "read_only": 1
    },
    {
      "fieldname": "packing_status",
      "label": "Packing Status",
      "fieldtype": "Select",
      "options": "Not Started\nIn Process\nPacked",
      "reqd": 1,
      "default": "Not Started",
      "read_only": 1
    },
    {
      "fieldname": "loading_status",
      "label": "Loading Status",
      "fieldtype": "Select",
      "options": "Not Started\nIn Process\nLoaded",
      "reqd": 1,
      "default": "Not Started",
      "read_only": 1
    },
    {
      "fieldname": "goods_issue_status",
      "label": "Goods Issue Status",
      "fieldtype": "Select",
      "options": "Not Posted\nPartially Posted\nPosted\nReversed",
      "reqd": 1,
      "default": "Not Posted",
      "read_only": 1
    },
    {
      "fieldname": "external_reference",
      "label": "External Reference",
      "fieldtype": "Data"
    },
    {
      "fieldname": "customer_instruction_reference",
      "label": "Customer Instruction Reference",
      "fieldtype": "Data"
    },
    {
      "fieldname": "items",
      "label": "Items",
      "fieldtype": "Table",
      "options": "Outbound Delivery Item",
      "reqd": 1
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "erp_section",
      "label": "ERP Origin & Completion",
      "fieldtype": "Section Break",
      "collapsible": 1
    },
    {
      "fieldname": "erp_source_doctype",
      "label": "ERP Source Document Type",
      "fieldtype": "Link",
      "options": "DocType",
      "read_only": 1,
      "description": "The ERPNext document this delivery was replicated from (Purchase/Sales Order, or a draft Purchase Receipt/Delivery Note)."
    },
    {
      "fieldname": "erp_source_name",
      "label": "ERP Source Document",
      "fieldtype": "Dynamic Link",
      "options": "erp_source_doctype",
      "read_only": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_erp",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "closed_short",
      "label": "Completed Short",
      "fieldtype": "Check",
      "read_only": 1,
      "allow_on_submit": 1,
      "description": "Closed before the full quantity was received/issued; the open remainder was taken off the delivery."
    },
    {
      "fieldname": "close_reason",
      "label": "Completion Remarks",
      "fieldtype": "Small Text",
      "allow_on_submit": 1,
      "read_only": 1
    },
    {
      "fieldname": "document_type",
      "label": "WMS Document Type",
      "fieldtype": "Link",
      "options": "WMS Document Type",
      "in_standard_filter": 1
    },
    {
      "fieldname": "delivery_request",
      "label": "Delivery Request",
      "fieldtype": "Link",
      "options": "WMS Delivery Request",
      "read_only": 1
    },
    {
      "fieldname": "stock_owner",
      "label": "Owner",
      "fieldtype": "Link",
      "options": "WMS Stock Owner",
      "in_standard_filter": 1,
      "description": "Who owns the stock (legal owner; blank = the warehouse's own stock)."
    },
    {
      "fieldname": "entitled_party",
      "label": "Party Entitled to Dispose",
      "fieldtype": "Link",
      "options": "WMS Stock Owner",
      "in_standard_filter": 1,
      "description": "Who may dispose of the stock (the ERP plant / company side); blank = same as the warehouse's company."
    }
  ],
  "autoname": "OBD-.########",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Administrator",
      "read": 1,
      "write": 1,
