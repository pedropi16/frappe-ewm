{
  "name": "WMS Wave",
  "module": "WMS Outbound",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "warehouse",
    "route",
    "ship_date",
    "priority",
    "picking_strategy",
    "status",
    "deliveries",
    "released_at",
    "released_by"
  ],
  "fields": [
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "route",
      "label": "Route",
      "fieldtype": "Link",
      "options": "WMS Route"
    },
    {
      "fieldname": "ship_date",
      "label": "Ship Date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nNormal\nHigh\nUrgent",
      "reqd": 1,
      "default": "Normal"
    },
    {
      "fieldname": "picking_strategy",
      "label": "Picking Strategy",
      "fieldtype": "Select",
      "options": "Single Order\nCluster",
      "reqd": 1,
      "default": "Single Order",
      "description": "Single Order creates one pick task per allocation. Cluster combines allocations for the same product/bin/HU across every delivery in the wave into one pick task."
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nReleased\nPicking\nPicked\nCompleted\nCancelled",
      "reqd": 1,
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "deliveries",
      "label": "Deliveries",
      "fieldtype": "Table",
      "options": "WMS Wave Delivery",
      "reqd": 1
    },
    {
      "fieldname": "released_at",
      "label": "Released At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "released_by",
      "label": "Released By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    }
  ],
  "autoname": "WAVE-.########",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Supervisor",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0
    },
    {
      "role": "WMS Operator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0
    }
  ]
}
