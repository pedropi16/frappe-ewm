      "create": 1,
      "delete": 0,
      "submit": 1,
      "cancel": 0,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Receiver",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 1,
      "cancel": 0,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Supervisor",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 1,
      "cancel": 0,
      "report": 1,
