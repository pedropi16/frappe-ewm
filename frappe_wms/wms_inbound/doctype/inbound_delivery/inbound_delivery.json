{
  "name": "Inbound Delivery",
  "module": "WMS Inbound",
  "custom": 0,
  "is_submittable": 1,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "inbound_delivery_number",
    "warehouse",
    "yard_status",
    "document_type",
    "delivery_request",
    "supplier",
    "stock_owner",
    "entitled_party",
    "company",
    "external_reference",
    "expected_arrival",
    "receiving_bin",
    "status",
    "receipt_status",
    "process_status",
    "posting_date",
    "items",
    "cross_dock_plan",
    "remarks",
    "erp_section",
    "erp_source_doctype",
    "erp_source_name",
    "column_break_erp",
    "closed_short",
    "close_reason"
  ],
  "fields": [
    {
      "fieldname": "inbound_delivery_number",
      "label": "Inbound Delivery Number",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "supplier",
      "label": "Supplier",
      "fieldtype": "Link",
      "options": "Supplier",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "external_reference",
      "label": "External Reference",
      "fieldtype": "Data"
    },
    {
      "fieldname": "expected_arrival",
      "label": "Expected Arrival",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "receiving_bin",
      "label": "Receiving Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nExpected\nArrived\nReceiving\nPartially Received\nReceived\nPutaway In Process\nCompleted\nCancelled",
      "reqd": 1,
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "receipt_status",
      "label": "Receipt Status",
      "fieldtype": "Select",
      "options": "Not Received\nPartially Received\nFully Received",
      "reqd": 1,
      "default": "Not Received",
      "read_only": 1
    },
    {
      "fieldname": "process_status",
      "label": "Process Status",
      "fieldtype": "Select",
      "options": "Not Started\nIn Process\nCompleted\nException",
      "reqd": 1,
      "default": "Not Started",
      "read_only": 1
    },
    {
      "fieldname": "posting_date",
      "label": "Posting Date",
      "fieldtype": "Date",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "items",
      "label": "Items",
      "fieldtype": "Table",
      "options": "Inbound Delivery Item",
      "reqd": 1
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "erp_section",
      "label": "ERP Origin & Completion",
      "fieldtype": "Section Break",
      "collapsible": 1
    },
    {
      "fieldname": "erp_source_doctype",
      "label": "ERP Source Document Type",
      "fieldtype": "Link",
      "options": "DocType",
      "read_only": 1,
      "description": "The ERPNext document this delivery was replicated from (Purchase/Sales Order, or a draft Purchase Receipt/Delivery Note)."
    },
    {
      "fieldname": "erp_source_name",
      "label": "ERP Source Document",
      "fieldtype": "Dynamic Link",
      "options": "erp_source_doctype",
      "read_only": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_erp",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "closed_short",
      "label": "Completed Short",
      "fieldtype": "Check",
      "read_only": 1,
      "allow_on_submit": 1,
      "description": "Closed before the full quantity was received/issued; the open remainder was taken off the delivery."
    },
    {
      "fieldname": "close_reason",
      "label": "Completion Remarks",
      "fieldtype": "Small Text",
      "allow_on_submit": 1,
      "read_only": 1
    },
    {
      "fieldname": "cross_dock_plan",
      "label": "Planned Cross-Docking",
      "fieldtype": "Table",
      "options": "Inbound Cross Dock Plan",
      "read_only": 1,
      "allow_on_submit": 1,
      "description": "Open outbound demand reserved for this delivery before it arrives; goods receipt sends the stock straight to the delivery's staging bin."
    },
    {
      "fieldname": "document_type",
      "label": "WMS Document Type",
      "fieldtype": "Link",
      "options": "WMS Document Type",
      "in_standard_filter": 1
    },
    {
      "fieldname": "delivery_request",
      "label": "Delivery Request",
      "fieldtype": "Link",
      "options": "WMS Delivery Request",
      "read_only": 1
    },
    {
      "fieldname": "stock_owner",
      "label": "Owner",
      "fieldtype": "Link",
      "options": "WMS Stock Owner",
      "in_standard_filter": 1,
      "description": "Who owns the stock (legal owner; blank = the warehouse's own stock)."
    },
    {
      "fieldname": "entitled_party",
      "label": "Party Entitled to Dispose",
      "fieldtype": "Link",
      "options": "WMS Stock Owner",
      "in_standard_filter": 1,
      "description": "Who may dispose of the stock (the ERP plant / company side); blank = same as the warehouse's company."
    },
    {
      "fieldname": "yard_status",
      "label": "Yard Status",
      "fieldtype": "Select",
      "options": "\nExpected\nIn Yard\nAt Door\nDeparted",
      "read_only": 1,
      "description": "Where the truck carrying this document is (dock appointment / transportation unit)."
    }
  ],
  "autoname": "IBD-.########",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Operator",
      "read": 1,
