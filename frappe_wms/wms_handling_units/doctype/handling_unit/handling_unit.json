{
  "name": "Handling Unit",
  "module": "WMS Handling Units",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "hu_number",
    "hu_type",
    "packaging_material",
    "warehouse",
    "current_bin",
    "parent_hu",
    "top_hu",
    "hierarchy_level",
    "status",
    "stock_status",
    "gross_weight",
    "tare_weight",
    "net_weight",
    "volume",
    "length",
    "width",
    "height",
    "max_payload_weight",
    "current_resource",
    "outbound_delivery",
    "shipment",
    "seal_number",
    "closed",
    "loaded",
    "external_reference",
    "sscc"
  ],
  "fields": [
    {
      "fieldname": "hu_number",
      "label": "HU Number",
      "fieldtype": "Data",
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Leave blank to auto-assign the next number from a WMS Number Range (only allowed when HU Type uses Internal numbering)."
    },
    {
      "fieldname": "hu_type",
      "label": "HU Type",
      "fieldtype": "Link",
      "options": "Handling Unit Type",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Auto-filled from Packaging Material if left blank there first."
    },
    {
      "fieldname": "packaging_material",
      "label": "Packaging Material",
      "fieldtype": "Link",
      "options": "Packaging Material",
      "description": "Optional. Auto-fills HU Type and Tare Weight from the Packaging Material's own dimensions/weight."
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "in_standard_filter": 1,
      "read_only": 1,
      "description": "Derived from Storage Bin (or the parent Handling Unit)."
    },
    {
      "fieldname": "current_bin",
      "label": "Current Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "mandatory_depends_on": "eval:!doc.parent_hu",
      "in_standard_filter": 1
    },
    {
      "fieldname": "parent_hu",
      "label": "Parent HU",
      "fieldtype": "Link",
      "options": "Handling Unit",
      "description": "Alternative to Current Bin - nests this HU inside another one, in that HU's bin."
    },
    {
      "fieldname": "top_hu",
      "label": "Top HU",
      "fieldtype": "Link",
      "options": "Handling Unit"
    },
    {
      "fieldname": "hierarchy_level",
      "label": "Hierarchy Level",
      "fieldtype": "Int",
      "default": 0,
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Created\nPlanned\nOpen\nClosed\nIn Process\nStaged\nLoaded\nShipped\nEmpty\nBlocked\nCancelled\nIn Transit",
      "reqd": 1,
      "default": "Created",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "stock_status",
      "label": "Stock Status",
      "fieldtype": "Select",
      "options": "Empty\nPartial\nFull",
      "reqd": 1,
      "default": "Empty",
      "read_only": 1
    },
    {
      "fieldname": "gross_weight",
      "label": "Gross Weight",
      "fieldtype": "Float",
      "default": 0,
      "read_only": 1
    },
    {
      "fieldname": "tare_weight",
      "label": "Tare Weight",
      "fieldtype": "Float",
      "default": 0,
      "read_only": 1
    },
    {
      "fieldname": "net_weight",
      "label": "Net Weight",
      "fieldtype": "Float",
      "default": 0,
      "read_only": 1
    },
    {
      "fieldname": "volume",
      "label": "Volume",
      "fieldtype": "Float",
      "default": 0,
      "read_only": 1
    },
    {
      "fieldname": "outbound_delivery",
      "label": "Outbound Delivery",
      "fieldtype": "Link",
      "options": "Outbound Delivery"
    },
    {
      "fieldname": "shipment",
      "label": "Shipment",
      "fieldtype": "Link",
      "options": "WMS Shipment"
    },
    {
      "fieldname": "seal_number",
      "label": "Seal Number",
      "fieldtype": "Data"
    },
    {
      "fieldname": "closed",
      "label": "Closed",
      "fieldtype": "Check",
      "default": 0,
      "read_only": 1
    },
    {
      "fieldname": "loaded",
      "label": "Loaded",
      "fieldtype": "Check",
      "default": 0,
      "read_only": 1
    },
    {
      "fieldname": "external_reference",
      "label": "External Reference",
      "fieldtype": "Data"
    },
    {
      "fieldname": "sscc",
      "label": "SSCC",
      "fieldtype": "Data",
      "unique": 1,
      "read_only": 1,
      "description": "Serial Shipping Container Code (GS1 SSCC-18), assigned on demand via services/labeling.generate_sscc - printed on the HU label. Blank until generated."
    },
    {
      "fieldname": "length",
      "label": "Length",
      "fieldtype": "Float"
    },
    {
      "fieldname": "width",
      "label": "Width",
      "fieldtype": "Float"
    },
    {
      "fieldname": "height",
      "label": "Height",
      "fieldtype": "Float"
    },
    {
      "fieldname": "max_payload_weight",
      "label": "Maximum Payload",
      "fieldtype": "Float",
      "description": "From the HU type; the net weight of the contents may not exceed it."
    },
    {
      "fieldname": "current_resource",
      "label": "At Resource",
      "fieldtype": "Link",
      "options": "WMS Resource",
      "description": "Set while a resource (forklift, trolley) carries the HU."
    }
  ],
  "autoname": "field:hu_number",
  "title_field": "hu_number",
  "search_fields": "hu_number, external_reference",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
