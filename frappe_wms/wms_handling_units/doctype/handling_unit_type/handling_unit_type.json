{
  "name": "Handling Unit Type",
  "module": "WMS Handling Units",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "hu_type_code",
    "hu_type_name",
    "category",
    "maximum_weight",
    "maximum_volume",
    "hu_type_group",
    "maximum_payload",
    "length",
    "width",
    "height",
    "nestable",
    "reusable",
    "requires_seal",
    "numbering_mode",
    "active"
  ],
  "fields": [
    {
      "fieldname": "hu_type_code",
      "label": "HU Type Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "hu_type_name",
      "label": "HU Type Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Select",
      "options": "Pallet\nBox\nCrate\nTote\nTrolley\nContainer\nOther",
      "reqd": 1
    },
    {
      "fieldname": "maximum_weight",
      "label": "Maximum Weight",
      "fieldtype": "Float"
    },
    {
      "fieldname": "maximum_volume",
      "label": "Maximum Volume",
      "fieldtype": "Float"
    },
    {
      "fieldname": "nestable",
      "label": "Nestable",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "reusable",
      "label": "Reusable",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "requires_seal",
      "label": "Requires Seal",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "numbering_mode",
      "label": "Numbering Mode",
      "fieldtype": "Select",
      "options": "External\nInternal",
      "default": "External",
      "reqd": 1,
      "description": "External: the HU number is a pre-printed/scanned barcode supplied by the operator. Internal: the system always assigns the next number from a WMS Number Range, ignoring any number the caller passes."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "length",
      "label": "Length",
      "fieldtype": "Float",
      "description": "Outer size, same unit as Bin Type. With a size on both sides the HU is only put into bins whose Bin Type fits it - no list of allowed HU types per bin needed."
    },
    {
      "fieldname": "width",
      "label": "Width",
      "fieldtype": "Float",
      "description": "Outer size, same unit as Bin Type. With a size on both sides the HU is only put into bins whose Bin Type fits it - no list of allowed HU types per bin needed."
    },
    {
      "fieldname": "height",
      "label": "Height",
      "fieldtype": "Float",
      "description": "Outer size, same unit as Bin Type. With a size on both sides the HU is only put into bins whose Bin Type fits it - no list of allowed HU types per bin needed."
    },
    {
      "fieldname": "hu_type_group",
      "label": "HU Type Group",
      "fieldtype": "Link",
      "options": "Handling Unit Type Group"
    },
    {
      "fieldname": "maximum_payload",
      "label": "Maximum Payload",
      "fieldtype": "Float",
      "description": "Heaviest load the HU carries. Copied to new HUs of this type; a HU with a payload refuses more."
    }
  ],
  "autoname": "field:hu_type_code",
  "title_field": "hu_type_name",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
