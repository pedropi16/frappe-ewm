{
  "name": "Wave Template",
  "module": "WMS Setup",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "template_code",
    "template_name",
    "warehouse",
    "route",
    "priority",
    "picking_strategy",
    "cutoff_time",
    "auto_release",
    "active"
  ],
  "fields": [
    {
      "fieldname": "template_code",
      "label": "Template Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "template_name",
      "label": "Template Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "route",
      "label": "Route",
      "fieldtype": "Link",
      "options": "WMS Route",
      "description": "Optional - leave blank to sweep deliveries for every route."
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nNormal\nHigh\nUrgent",
      "reqd": 1,
      "default": "Normal"
    },
    {
      "fieldname": "picking_strategy",
      "label": "Picking Strategy",
      "fieldtype": "Select",
      "options": "Single Order\nCluster",
      "reqd": 1,
      "default": "Single Order"
    },
    {
      "fieldname": "cutoff_time",
      "label": "Cutoff Time",
      "fieldtype": "Time",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Daily cutoff - a wave generated from this template auto-releases once this time passes for the day, if Auto Release is checked."
    },
    {
      "fieldname": "auto_release",
      "label": "Auto Release",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    }
  ],
  "autoname": "field:template_code",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Supervisor",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0
    },
    {
      "role": "WMS Operator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0
    }
  ]
}
