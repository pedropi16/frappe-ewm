{
  "name": "Production Supply Control Cycle",
  "module": "WMS Setup",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "production_supply_area",
    "product",
    "staging_method",
    "staging_bin",
    "minimum_quantity",
    "maximum_quantity",
    "active",
    "source_storage_type",
    "kanban_rule"
  ],
  "fields": [
    {
      "fieldname": "production_supply_area",
      "label": "Production Supply Area",
      "fieldtype": "Link",
      "options": "Production Supply Area",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "product",
      "label": "Product",
      "fieldtype": "Link",
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "staging_method",
      "label": "Staging Method",
      "fieldtype": "Select",
      "options": "Pick Parts\nRelease Order Parts\nCrate Parts\nDirect Consumption\nKanban",
      "default": "Pick Parts",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Pick Parts: staged per order, reserved to it. Release Order Parts: demand of several orders staged together, pooled. Crate Parts: kept between a minimum and maximum in the PSA, independent of orders. Direct Consumption: not staged, consumed from where it is stored."
    },
    {
      "fieldname": "staging_bin",
      "label": "Staging Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "description": "One of the PSA's bins; blank = its supply bin."
    },
    {
      "fieldname": "minimum_quantity",
      "label": "Minimum Quantity",
      "fieldtype": "Float",
      "description": "Crate Parts: replenish when the PSA stock falls below this."
    },
    {
      "fieldname": "maximum_quantity",
      "label": "Maximum Quantity",
      "fieldtype": "Float",
      "description": "Crate Parts: replenish up to this."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "source_storage_type",
      "label": "Refill From Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type",
      "depends_on": "eval:doc.staging_method=='Kanban'",
      "mandatory_depends_on": "eval:doc.staging_method=='Kanban'",
      "description": "Kanban: the storage type the kanban bin is refilled from."
    },
    {
      "fieldname": "kanban_rule",
      "label": "Replenishment Rule",
      "fieldtype": "Link",
      "options": "Replenishment Rule",
      "read_only": 1,
      "depends_on": "eval:doc.staging_method=='Kanban'"
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
