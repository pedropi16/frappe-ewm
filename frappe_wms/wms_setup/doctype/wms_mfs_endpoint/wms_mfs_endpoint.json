{
  "name": "WMS MFS Endpoint",
  "module": "WMS Setup",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "endpoint_code",
    "endpoint_name",
    "warehouse",
    "mode",
    "host",
    "port",
    "terminator",
    "telegram_length",
    "encoding",
    "timeout_seconds",
    "wait_for_ack",
    "active"
  ],
  "fields": [
    {
      "fieldname": "endpoint_code",
      "label": "Endpoint Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "endpoint_name",
      "label": "Name",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse"
    },
    {
      "fieldname": "mode",
      "label": "Mode",
      "fieldtype": "Select",
      "options": "Client\nServer",
      "default": "Client",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Client: the WMS connects to the PLC to send. Server: the WMS listens (bench execute frappe_wms.services.mfs.listen) and the PLC connects."
    },
    {
      "fieldname": "host",
      "label": "Host",
      "fieldtype": "Data",
      "description": "Client: the PLC's address. Server: the address to listen on.",
      "in_list_view": 1
    },
    {
      "fieldname": "port",
      "label": "Port",
      "fieldtype": "Int",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "terminator",
      "label": "Terminator",
      "fieldtype": "Data",
      "default": "\\n",
      "description": "Ends a telegram. Escapes: \\n \\r \\t. Blank with a fixed telegram length."
    },
    {
      "fieldname": "telegram_length",
      "label": "Fixed Telegram Length",
      "fieldtype": "Int",
      "description": "0 = telegrams end with the terminator."
    },
    {
      "fieldname": "encoding",
      "label": "Encoding",
      "fieldtype": "Data",
      "default": "ascii"
    },
    {
      "fieldname": "timeout_seconds",
      "label": "Timeout (s)",
      "fieldtype": "Int",
      "default": 5
    },
    {
      "fieldname": "wait_for_ack",
      "label": "Wait for Acknowledgement",
      "fieldtype": "Check",
      "description": "After sending, read one telegram back and log it as the acknowledgement."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
