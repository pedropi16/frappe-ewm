{
  "name": "Labor Shift",
  "module": "WMS Setup",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 0,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "warehouse",
    "shift_name",
    "start_time",
    "end_time",
    "active"
  ],
  "fields": [
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "shift_name",
      "label": "Shift",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "start_time",
      "label": "Start",
      "fieldtype": "Time",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "end_time",
      "label": "End",
      "fieldtype": "Time",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Earlier than the start = the shift runs past midnight"
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1
    }
  ],
  "autoname": "LSH-.####",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}