{
  "name": "WMS Document Type",
  "module": "WMS Setup",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "document_type_code",
    "document_type_name",
    "category",
    "warehouse",
    "is_default",
    "number_range",
    "active",
    "defaults",
    "field_control",
    "status_transitions"
  ],
  "fields": [
    {
      "fieldname": "document_type_code",
      "label": "Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "document_type_name",
      "label": "Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Select",
      "options": "Inbound Delivery\nOutbound Delivery\nWarehouse Request\nDelivery Request\nFinal Outbound Delivery",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "description": "Blank = every warehouse."
    },
    {
      "fieldname": "is_default",
      "label": "Default",
      "fieldtype": "Check",
      "description": "Used for new documents of the category (in the warehouse) that name no type."
    },
    {
      "fieldname": "number_range",
      "label": "Number Range",
      "fieldtype": "Link",
      "options": "WMS Number Range",
      "description": "Names the documents of this type from this range instead of the category's general one."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "defaults",
      "label": "Field Defaults",
      "fieldtype": "Table",
      "options": "WMS Document Type Default",
      "description": "Filled in on a new document when the field is blank."
    },
    {
      "fieldname": "field_control",
      "label": "Field Control",
      "fieldtype": "Table",
      "options": "WMS Document Type Field"
    },
    {
      "fieldname": "status_transitions",
      "label": "Status Profile",
      "fieldtype": "Table",
      "options": "WMS Document Type Transition",
      "description": "Allowed changes of the Status field when saving a document of this type. Empty = any change."
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
