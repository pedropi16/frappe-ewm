{
  "name": "Labor Standard",
  "module": "WMS Setup",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "priority",
    "warehouse",
    "task_type",
    "item_group",
    "standard_seconds_per_unit",
    "base_allowance_seconds",
    "travel_seconds_per_meter",
    "handling_seconds_per_kg",
    "handling_seconds_per_volume",
    "pfd_percent",
    "active"
  ],
  "fields": [
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Int",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "in_list_view": 1,
      "description": "Optional - leave blank for a default standard that applies to every warehouse."
    },
    {
      "fieldname": "task_type",
      "label": "Task Type",
      "fieldtype": "Select",
      "options": "Unload\nPutaway\nPick\nInternal Move\nDeconsolidation\nConsolidation\nStage\nLoad\nPosting Change\nInventory Count\nSort",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "item_group",
      "label": "Item Group",
      "fieldtype": "Link",
      "options": "Item Group",
      "description": "Optional - leave blank to match every item group."
    },
    {
      "fieldname": "standard_seconds_per_unit",
      "label": "Standard Seconds per Unit",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Expected seconds per unit of planned_quantity for a matching task."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "base_allowance_seconds",
      "label": "Base Allowance (s)",
      "fieldtype": "Float",
      "description": "Fixed time per task (get the equipment, scan, confirm)."
    },
    {
      "fieldname": "travel_seconds_per_meter",
      "label": "Travel (s per distance unit)",
      "fieldtype": "Float",
      "description": "Times the task's own leg (source to destination bin, from the coordinates)."
    },
    {
      "fieldname": "handling_seconds_per_kg",
      "label": "Handling (s per kg)",
      "fieldtype": "Float",
      "description": "Times the task's weight (gross weight per unit x quantity)."
    },
    {
      "fieldname": "handling_seconds_per_volume",
      "label": "Handling (s per volume unit)",
      "fieldtype": "Float"
    },
    {
      "fieldname": "pfd_percent",
      "label": "Personal, Fatigue & Delay %",
      "fieldtype": "Percent",
      "description": "Added on top of the total."
    }
  ],
  "autoname": "LS-.#####",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Operator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
