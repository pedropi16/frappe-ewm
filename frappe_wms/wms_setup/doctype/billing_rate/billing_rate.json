      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "uom_basis",
      "label": "UOM Basis",
      "fieldtype": "Select",
      "options": "Per Task\nPer Unit",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "rate",
      "label": "Rate",
      "fieldtype": "Currency",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "billing_item",
      "label": "Billing Item",
      "fieldtype": "Link",
      "options": "Item",
      "reqd": 1,
