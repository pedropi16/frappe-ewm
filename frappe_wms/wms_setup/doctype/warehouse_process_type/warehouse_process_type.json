{
  "name": "Warehouse Process Type",
  "module": "WMS Setup",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "process_type_code",
    "process_type_name",
    "activity",
    "source_required",
    "destination_required",
    "default_source_storage_type",
    "default_source_bin",
    "default_destination_storage_type",
    "default_destination_bin",
    "default_queue",
    "default_priority",
    "hu_required",
    "stock_required",
    "confirmation_mode",
    "movement_type",
    "picking_section",
    "picking_strategy",
    "pick_pack_pass_hu_type",
    "active"
  ],
  "fields": [
    {
      "fieldname": "process_type_code",
      "label": "Process Type Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "process_type_name",
      "label": "Process Type Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "activity",
      "label": "Activity",
      "fieldtype": "Select",
      "options": "Unload\nPutaway\nPick\nInternal Move\nDeconsolidation\nConsolidation\nPack\nStage\nLoad\nPosting Change\nInventory Count\nSort",
      "reqd": 1
    },
    {
      "fieldname": "source_required",
      "label": "Source Required",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "destination_required",
      "label": "Destination Required",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "hu_required",
      "label": "HU Required",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "stock_required",
      "label": "Stock Required",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "confirmation_mode",
      "label": "Confirmation Mode",
      "fieldtype": "Select",
      "options": "Product and Quantity\nHandling Unit\nBin to Bin\nSerial Number",
      "reqd": 1
    },
    {
      "fieldname": "movement_type",
      "label": "Movement Type",
      "fieldtype": "Link",
      "options": "WMS Movement Type",
      "reqd": 1
    },
    {
      "fieldname": "picking_section",
      "label": "Picking Strategy",
      "fieldtype": "Section Break",
      "depends_on": "eval:doc.activity=='Pick'"
    },
    {
      "fieldname": "picking_strategy",
      "label": "Picking Strategy",
      "fieldtype": "Select",
      "options": "Single-Step\nTwo-Step\nPick-Pack-Pass",
      "default": "Single-Step",
      "depends_on": "eval:doc.activity=='Pick'",
      "description": "Pick activity only. Single-Step (default, unchanged behavior): picks straight to the Outbound Delivery's own staging bin. Two-Step: picks to the warehouse's shared picking staging area first (WMS Warehouse.default_picking_staging_bin), then auto-creates a follow-up Sort task moving it on to the delivery. Pick-Pack-Pass: picks straight into one shared destination HU per delivery (Pick Pack Pass HU Type below), skipping a separate packing step."
    },
    {
      "fieldname": "pick_pack_pass_hu_type",
      "label": "Pick-Pack-Pass HU Type",
      "fieldtype": "Link",
      "options": "Handling Unit Type",
      "depends_on": "eval:doc.picking_strategy=='Pick-Pack-Pass'",
      "description": "The Handling Unit Type auto-created (once per delivery, reused across every pick line for it) as the final shipping container a picker packs straight into."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "default_source_storage_type",
      "label": "Default Source Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type"
    },
    {
      "fieldname": "default_source_bin",
      "label": "Default Source Bin",
      "fieldtype": "Link",
      "options": "Storage Bin"
    },
    {
      "fieldname": "default_destination_storage_type",
      "label": "Default Destination Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type",
      "description": "Used when the request names no destination: bin determination looks only in this storage type."
    },
    {
      "fieldname": "default_destination_bin",
      "label": "Default Destination Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "description": "Used when the request names no destination."
    },
    {
      "fieldname": "default_queue",
      "label": "Default Queue",
      "fieldtype": "Link",
      "options": "Warehouse Queue",
      "description": "Used when no queue is determined for the task."
    },
    {
      "fieldname": "default_priority",
      "label": "Default Priority",
      "fieldtype": "Select",
      "options": "\nLow\nNormal\nHigh\nUrgent"
    }
  ],
  "autoname": "field:process_type_code",
  "title_field": "process_type_name",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Operator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Receiver",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Picker",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Packer",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Loader",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Inventory Controller",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Supervisor",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Process Engineer",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Master Data",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Integration User",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "WMS Auditor",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ]
}