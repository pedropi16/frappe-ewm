{
  "name": "Bin Determination Rule",
  "module": "WMS Setup",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "priority",
    "warehouse",
    "activity",
    "item",
    "item_group",
    "stock_type",
    "hu_type",
    "source_storage_type",
    "destination_storage_type",
