      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Int",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "activity",
      "label": "Activity",
      "fieldtype": "Select",
      "options": "Putaway\nPick\nInternal Move\nStage\nLoad",
      "reqd": 1
    },
    {
      "fieldname": "item",
      "label": "Item",
      "fieldtype": "Link",
      "options": "Item"
    },
    {
      "fieldname": "item_group",
      "label": "Item Group",
      "fieldtype": "Link",
      "options": "Item Group"
    },
    {
      "fieldname": "stock_type",
      "label": "Stock Type",
      "fieldtype": "Link",
      "options": "WMS Stock Type"
    },
    {
      "fieldname": "hu_type",
      "label": "HU Type",
      "fieldtype": "Link",
      "options": "Handling Unit Type"
    },
    {
      "fieldname": "source_storage_type",
      "label": "Source Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type"
    },
    {
      "fieldname": "destination_storage_type",
      "label": "Destination Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type"
    },
    {
      "fieldname": "search_sequence",
      "label": "Storage Type Search Sequence",
      "fieldtype": "Link",
      "options": "Storage Type Search Sequence",
      "description": "Try several storage types in order instead of one fixed destination. Ignored when Destination Storage Type is also set."
    },
    {
      "fieldname": "destination_section",
      "label": "Destination Section",
      "fieldtype": "Link",
      "options": "Storage Section",
      "description": "Optional - restricts candidate bins to this Storage Section within the destination storage type."
    },
    {
      "fieldname": "fixed_destination_bin",
      "label": "Fixed Destination Bin",
      "fieldtype": "Link",
      "options": "Storage Bin"
    },
    {
      "fieldname": "strategy",
      "label": "Strategy",
      "fieldtype": "Select",
      "options": "Fixed Bin\nFirst Empty Bin\nAddition to Existing Stock\nBin Sequence\nLeast Utilized Bin\nManual Selection\nGeneral Storage\nPallet\nBulk\nNear Fixed Bin\nCustom",
      "reqd": 1
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "destination_storage_group",
      "label": "Destination Storage Group",
      "fieldtype": "Link",
      "options": "Storage Group"
    },
    {
      "fieldname": "custom_strategy",
      "label": "Custom Strategy",
      "fieldtype": "Data",
      "depends_on": "eval:doc.strategy=='Custom'",
      "description": "Name registered by an app under hooks.py wms_putaway_strategies: a function (bins, context) -> bins, best first."
    }
  ],
  "autoname": "BDR-.#####",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
