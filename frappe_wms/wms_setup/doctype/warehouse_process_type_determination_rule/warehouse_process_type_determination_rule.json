    {
      "fieldname": "process_type",
      "label": "Process Type",
      "fieldtype": "Link",
      "options": "Warehouse Process Type",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    }
