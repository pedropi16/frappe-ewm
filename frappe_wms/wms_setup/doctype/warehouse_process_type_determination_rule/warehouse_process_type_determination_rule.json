    "warehouse",
    "activity",
    "item",
    "item_group",
    "stock_type",
    "priority_level",
    "process_type_determination_indicator",
    "process_type",
    "active"
  ],
  "fields": [
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Int",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "in_list_view": 1,
      "description": "Optional - leave blank for a default rule that applies to every warehouse."
    },
    {
      "fieldname": "activity",
      "label": "Activity",
      "fieldtype": "Select",
      "options": "Putaway\nPick\nInternal Move\nStage\nLoad\nDeconsolidation\nReplenish",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "item",
      "label": "Item",
      "fieldtype": "Link",
      "options": "Item"
    },
    {
      "fieldname": "item_group",
      "label": "Item Group",
      "fieldtype": "Link",
      "options": "Item Group"
    },
    {
      "fieldname": "stock_type",
      "label": "Stock Type",
      "fieldtype": "Link",
      "options": "WMS Stock Type"
    },
    {
      "fieldname": "priority_level",
      "label": "Delivery Priority",
      "fieldtype": "Select",
      "options": "\nLow\nNormal\nHigh\nUrgent"
    },
    {
      "fieldname": "process_type_determination_indicator",
      "label": "Process Type Determination Indicator",
      "fieldtype": "Data",
      "description": "Optional - matches WMS Product Warehouse's Process Type Determination Indicator for the product/warehouse in context."
