{
  "name": "Cycle Count Rule",
  "module": "WMS Setup",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "priority",
    "warehouse",
    "procedure_type",
    "abc_indicator",
    "storage_type",
    "frequency_days",
    "active"
  ],
  "fields": [
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Int",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "procedure_type",
      "label": "Procedure Type",
      "fieldtype": "Select",
      "options": "ABC Cycle Count\nLow Stock\nZero Stock\nPutaway PI\nBin Check\nAnnual",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "abc_indicator",
      "label": "ABC Indicator",
      "fieldtype": "Select",
      "options": "\nA\nB\nC",
      "description": "Only read when Procedure Type is ABC Cycle Count - selects which WMS Product ABC class this rule generates counts for."
    },
    {
      "fieldname": "storage_type",
      "label": "Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type",
      "description": "Optional scope - used by Bin Check (required there) and to narrow Low Stock/Zero Stock/Putaway PI to one storage type."
    },
    {
      "fieldname": "frequency_days",
      "label": "Frequency (Days)",
      "fieldtype": "Int",
      "reqd": 1,
      "in_list_view": 1,
      "description": "How often a matching scope gets a new count generated - a scope already covered by a count within this many days is skipped."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    }
  ],
  "autoname": "CCR-.#####",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "WMS Operator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0
    }
  ]
}
