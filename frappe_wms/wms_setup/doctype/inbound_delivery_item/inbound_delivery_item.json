{
  "name": "Inbound Delivery Item",
  "module": "WMS Setup",
  "custom": 0,
  "is_submittable": 0,
  "istable": 1,
  "track_changes": 0,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "line_number",
    "item",
    "item_name",
    "expected_quantity",
    "received_quantity",
    "putaway_quantity",
    "stock_uom",
    "uom",
    "conversion_factor",
    "batch_required",
    "serial_required",
    "expected_stock_type",
    "preferred_storage_type",
    "source_document_type",
    "source_document_number",
    "source_document_line",
    "purchase_order",
    "purchase_order_item",
    "status",
    "return_item_type",
    "country_of_origin",
    "special_stock_type",
    "special_stock_ref"
  ],
  "fields": [
    {
      "fieldname": "line_number",
      "label": "Line Number",
      "fieldtype": "Int",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "item",
      "label": "Item",
      "fieldtype": "Link",
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "item_name",
      "label": "Item Name",
      "fieldtype": "Data",
      "fetch_from": "item.item_name",
      "read_only": 1,
      "in_list_view": 0
    },
    {
      "fieldname": "expected_quantity",
      "label": "Expected Quantity",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "received_quantity",
      "label": "Received Quantity",
      "fieldtype": "Float",
      "default": 0,
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "putaway_quantity",
      "label": "Putaway Quantity",
      "fieldtype": "Float",
      "default": 0,
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "stock_uom",
      "label": "Stock UOM",
      "fieldtype": "Link",
      "options": "UOM",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "uom",
      "label": "UOM",
      "fieldtype": "Link",
      "options": "UOM",
      "description": "Transactional unit (e.g. the purchasing UOM). Defaults to Stock UOM when left blank."
    },
    {
      "fieldname": "conversion_factor",
      "label": "Conversion Factor",
      "fieldtype": "Float",
      "default": 1.0,
      "description": "How many Stock UOM per UOM. WMS ledger/balance quantities always stay in Stock UOM; this only affects how quantity is labeled on the mirrored ERPNext document."
    },
    {
      "fieldname": "batch_required",
      "label": "Batch Required",
      "fieldtype": "Check",
      "default": 0,
      "read_only": 1
    },
    {
      "fieldname": "serial_required",
      "label": "Serial Required",
      "fieldtype": "Check",
      "default": 0,
      "read_only": 1
    },
    {
      "fieldname": "expected_stock_type",
      "label": "Expected Stock Type",
      "fieldtype": "Link",
      "options": "WMS Stock Type",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "preferred_storage_type",
      "label": "Preferred Storage Type",
      "fieldtype": "Link",
      "options": "Storage Type"
    },
    {
      "fieldname": "source_document_type",
      "label": "Source Document Type",
      "fieldtype": "Data"
    },
    {
      "fieldname": "source_document_number",
      "label": "Source Document Number",
      "fieldtype": "Data"
    },
    {
      "fieldname": "source_document_line",
      "label": "Source Document Line",
      "fieldtype": "Data",
      "description": "The specific row on the source document this line traces back to - e.g. the original Delivery Note Item for a customer return, so the mirrored ERPNext return document can be built row-for-row instead of guessed by item code alone."
    },
    {
      "fieldname": "purchase_order",
      "label": "Purchase Order",
      "fieldtype": "Link",
      "options": "Purchase Order",
      "read_only": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "purchase_order_item",
      "label": "Purchase Order Item",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Open\nPartially Received\nReceived\nPutaway In Process\nCompleted\nCancelled",
      "reqd": 1,
      "default": "Open",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "return_item_type",
      "label": "Return Item Type",
      "fieldtype": "Link",
      "options": "Return Item Type",
      "read_only": 1
    },
    {
      "fieldname": "country_of_origin",
      "label": "Country of Origin",
      "fieldtype": "Link",
      "options": "Country"
    },
    {
      "fieldname": "special_stock_type",
      "label": "Special Stock",
      "fieldtype": "Select",
      "options": "\nSales Order\nProject",
      "description": "Stock reserved to a sales order or project: only that order/project's deliveries may take it."
    },
    {
      "fieldname": "special_stock_ref",
      "label": "Special Stock Reference",
      "fieldtype": "Data"
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": []
}
