    {
      "fieldname": "allow_mixed_batches",
      "label": "Allow Mixed Batches",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "hu_managed",
      "label": "HU Managed",
      "fieldtype": "Check",
      "hidden": 1,
      "description": "Superseded by HU Requirement."
    },
    {
      "fieldname": "capacity_check_method",
      "label": "Capacity Check Method",
      "fieldtype": "Select",
      "options": "None\nHU Count\nWeight\nVolume\nMax Quantity",
      "reqd": 1,
      "default": "None"
    },
    {
      "fieldname": "putaway_blocked",
      "label": "Putaway Blocked",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "removal_blocked",
      "label": "Removal Blocked",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "hu_requirement",
      "label": "HU Requirement",
      "fieldtype": "Select",
      "options": "Optional\nMandatory\nForbidden",
      "description": "Mandatory: only Handling Units are put into its bins. Forbidden: stock is put in loose (HUs are unpacked on putaway). Optional (or blank): either. Blank on an old type follows the previous HU managed flag.",
      "default": "Mandatory"
    },
    {
      "fieldname": "hu_type_check",
      "label": "HU Type Check",
      "fieldtype": "Check",
      "default": 1,
      "description": "Check that the HU type fits the bin type (size) at putaway."
    },
    {
      "fieldname": "putaway_strategy",
      "label": "Default Putaway Strategy",
      "fieldtype": "Select",
      "options": "\nFixed Bin\nFirst Empty Bin\nAddition to Existing Stock\nBin Sequence\nLeast Utilized Bin\nGeneral Storage\nPallet\nBulk\nNear Fixed Bin",
      "description": "Used when no Bin Determination Rule applies."
    }
  ],
  "autoname": "format:{warehouse}-{storage_type_code}",
