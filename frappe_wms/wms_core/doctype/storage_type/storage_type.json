      "fieldname": "storage_type_name",
      "label": "Storage Type Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "storage_role",
      "label": "Storage Role",
      "fieldtype": "Select",
      "options": "Receiving\nStorage\nPicking\nPacking\nStaging\nDoor\nShipping\nDifference\nProduction Supply\nYard\nCheckpoint\nIdentification Point",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "allow_mixed_products",
      "label": "Allow Mixed Products",
