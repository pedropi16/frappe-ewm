{
  "name": "Work Center",
  "module": "WMS Core",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "warehouse",
    "work_center_code",
    "work_center_name",
    "bin",
    "active"
  ],
  "fields": [
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "work_center_code",
      "label": "Work Center Code",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "work_center_name",
      "label": "Work Center Name",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "bin",
      "label": "Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "reqd": 1,
      "in_list_view": 1,
      "description": "The physical station bin (e.g. a Packing-role bin) this Work Center resolves to. Actions that need a work center bin (VAS generation, Packing, Kitting) can default to it once an operator logs on to this Work Center."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    }
  ],
  "autoname": "format:{warehouse}-{work_center_code}",
  "title_field": "work_center_name",
  "sort_field": "modified",
  "sort_order": "DESC",
