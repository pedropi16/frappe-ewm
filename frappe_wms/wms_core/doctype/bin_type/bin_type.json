    "maximum_volume",
    "maximum_quantity",
    "length",
    "width",
    "height",
    "active"
  ],
  "fields": [
    {
      "fieldname": "bin_type_code",
      "label": "Bin Type Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "bin_type_name",
      "label": "Bin Type Name",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "maximum_weight",
      "label": "Maximum Weight",
      "fieldtype": "Float"
    },
    {
      "fieldname": "maximum_volume",
      "label": "Maximum Volume",
      "fieldtype": "Float"
    },
    {
      "fieldname": "length",
      "label": "Length",
      "fieldtype": "Float",
      "description": "Inner size of a bin of this type (same unit as the HU types'). A Handling Unit fits when its type's size fits, in either floor orientation."
    },
    {
      "fieldname": "width",
      "label": "Width",
      "fieldtype": "Float",
      "description": "Inner size of a bin of this type (same unit as the HU types'). A Handling Unit fits when its type's size fits, in either floor orientation."
    },
    {
      "fieldname": "height",
      "label": "Height",
      "fieldtype": "Float",
      "description": "Inner size of a bin of this type (same unit as the HU types'). A Handling Unit fits when its type's size fits, in either floor orientation."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "maximum_hus",
      "label": "Maximum HUs",
      "fieldtype": "Int",
      "description": "How many top-level Handling Units a bin of this type holds (a pallet location: 1). A bin's own value wins."
    },
    {
      "fieldname": "maximum_quantity",
      "label": "Maximum Quantity",
      "fieldtype": "Float",
      "description": "Capacity check method Max Quantity: most stock (any product, stock UoM) the bin holds. A bin's own value wins over its Bin Type's."
    }
  ],
  "autoname": "field:bin_type_code",
  "title_field": "bin_type_name",
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
