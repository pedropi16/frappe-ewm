{
  "name": "Bin Type",
  "module": "WMS Core",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "bin_type_code",
    "bin_type_name",
    "maximum_hus",
