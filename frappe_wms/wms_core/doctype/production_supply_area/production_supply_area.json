{
  "name": "Production Supply Area",
  "module": "WMS Core",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "warehouse",
    "psa_code",
    "psa_name",
    "supply_bin",
    "output_bin",
    "bins",
    "staging_mode",
    "workstations",
    "deconsolidation_work_center",
    "active"
  ],
  "fields": [
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "psa_code",
      "label": "PSA Code",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "psa_name",
      "label": "PSA Name",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "supply_bin",
      "label": "Supply Bin (default)",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "reqd": 1,
      "in_list_view": 1,
      "description": "The bin at the production floor staged material is put into, and consumed from as orders start or complete."
    },
    {
      "fieldname": "workstations",
      "label": "Workstations",
      "fieldtype": "Table",
      "options": "PSA Workstation",
      "description": "Operations running at these workstations are supplied through this PSA."
    },
    {
      "fieldname": "deconsolidation_work_center",
      "label": "Deconsolidation Work Center",
      "fieldtype": "Link",
      "options": "Work Center",
      "description": "Optional: material picked in several areas is collected here before it moves to the supply bin."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "staging_mode",
      "label": "Staging Mode",
      "fieldtype": "Select",
      "options": "Manual\nAutomatic",
      "default": "Manual",
      "description": "Automatic: open PMR items are staged by single-order tasks from the oldest stock, when the PMR is created and hourly. Manual: staged in the Production Staging app."
    },
    {
      "fieldname": "bins",
      "label": "Further Bins",
      "fieldtype": "Table",
      "options": "PSA Bin",
      "description": "More bins of this PSA (rack positions, line-side bins). The supply bin is the default; a control cycle can name another."
    },
    {
      "fieldname": "output_bin",
      "label": "Production Output Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "description": "Where finished goods of this area are received first (then put away by the Putaway rules for production receipts). Blank = the warehouse's production receiving bin."
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "doctype": "DocType",
  "permissions": [
