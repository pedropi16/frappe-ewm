{
  "name": "Production Supply Area",
  "module": "WMS Core",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "warehouse",
    "psa_code",
    "psa_name",
    "production_warehouse",
    "deconsolidation_work_center",
    "supply_bin",
