  "fields": [
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
      "options": "WMS Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "psa_code",
      "label": "PSA Code",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "psa_name",
      "label": "PSA Name",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "production_warehouse",
      "label": "Production Warehouse",
      "fieldtype": "Link",
      "options": "Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "The ERPNext warehouse a Material Request delivers into (e.g. Work In Progress). A submitted Material Transfer to this warehouse is supplied through this PSA."
    },
    {
      "fieldname": "supply_bin",
      "label": "Supply Bin",
      "fieldtype": "Link",
      "options": "Storage Bin",
      "reqd": 1,
      "description": "The PSA bin at the production floor: the complete set is delivered here on one Handling Unit, and consumed from here as orders start or complete."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "deconsolidation_work_center",
      "label": "Deconsolidation Work Center",
      "fieldtype": "Link",
      "options": "Work Center",
      "reqd": 1,
      "description": "Everything picked for a Material Request goes to one free location of this station, and moves on to the supply bin once the whole request has arrived."
    }
  ],
  "autoname": "format:{warehouse}-{psa_code}",
  "title_field": "psa_name",
  "sort_field": "modified",
  "sort_order": "DESC",
